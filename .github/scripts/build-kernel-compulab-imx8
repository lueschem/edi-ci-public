#!/bin/bash

# Run kernel build within a virgin Debian container.

set -o errexit
set -o pipefail
set -o nounset

if [[ $EUID -ne 0 ]]
then
    >&2 echo "Error: This script must be run as root."
    exit 1
fi

if [[ $# -ne 2 ]]
then
    >&2 echo "Error: This script expects two parameters:"
    >&2 echo "       build-kernel-compulab-imx8 GIT_TAG [compulab_v8|iot-gate-imx8]"
    exit 1
fi

GIT_TAG="${1}"
MACHINE="${2}"

SCRIPTDIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

cd "${SCRIPTDIR}/../.."

export DEBIAN_FRONTEND=noninteractive
dpkg --add-architecture arm64
apt-get update > /dev/null
apt-get --no-install-recommends -y install git ca-certificates build-essential crossbuild-essential-arm64 bc kmod cpio flex cpio lsb-release libdw-dev libncurses5-dev bison libelf-dev libssl-dev libssl-dev:arm64 wget lzop rsync debhelper fakeroot python3

DIR_PREFIX="cl"
mkdir -p "${DIR_PREFIX}-${GIT_TAG}"
cd "${DIR_PREFIX}-${GIT_TAG}"

REPOSITORY_NAME="linux-compulab"
git clone --revision "${GIT_TAG}" --depth 1 "https://github.com/compulab-yokneam/${REPOSITORY_NAME}.git"
cd "${REPOSITORY_NAME}"
export ARCH=arm64
export CROSS_COMPILE=aarch64-linux-gnu-

if [ "${MACHINE}" == "iot-gate-imx8" ]
then
    make cl-imx8m-mini_defconfig "${MACHINE}".config
elif [ "${MACHINE}" == "compulab_v8" ]
then
    if [ -f arch/arm64/configs/compulab.config ]
    then
        make "${MACHINE}"_defconfig compulab.config
    else
        make "${MACHINE}"_defconfig
    fi
else
    >&2 echo "Error: Machine type '${MACHINE}' is not supported."
    exit 1
fi

scripts/config --enable CONFIG_BTRFS_FS
make -j "$(nproc)" KBUILD_IMAGE=arch/arm64/boot/Image deb-pkg

BUILD_OUTPUT="${SCRIPTDIR}/../../build-output"
mkdir -p "${BUILD_OUTPUT}"
find ../ -maxdepth 1 -type f -exec cp {} "${BUILD_OUTPUT}" \;

echo "========"
echo "Success!"
echo "========"
